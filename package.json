{
  "name": "active-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": {
    "packages": [
      "apps/client",
      "tools/promo",
      "packages/api-client"
    ],
    "nohoist": [
      "active-cadence-promo",
      "active-cadence-promo/**"
    ]
  },
  "scripts": {
    "start": "yarn workspace active-next start",
    "start:clear": "yarn workspace active-next start:clear",
    "android": "yarn workspace active-next android",
    "ios": "yarn workspace active-next ios",
    "web": "yarn workspace active-next web",
    "test": "yarn workspace active-next test",
    "test:once": "yarn workspace active-next test:once",
    "test:sync": "yarn workspace active-next test:sync",
    "typecheck": "yarn workspace active-next typecheck",
    "format": "yarn workspace active-next format",
    "format:check": "yarn workspace active-next format:check",
    "legal:sync": "python3 scripts/sync-legal.py",
    "legal:check": "python3 scripts/test_sync_legal.py && python3 scripts/sync-legal.py --check",
    "site:check": "python3 apps/site/verify.py",
    "promo:studio": "yarn workspace active-cadence-promo studio",
    "promo:render": "yarn workspace active-cadence-promo render",
    "promo:poster": "yarn workspace active-cadence-promo poster",
    "client:export": "yarn workspace active-next expo export -p web",
    "api:run": "cargo run --locked -p active-api",
    "api:check": "cargo check --workspace --locked",
    "api:test": "cargo test --workspace --locked",
    "contract:generate": "node scripts/generate-contract.cjs",
    "contract:check": "node scripts/check-contract.cjs",
    "contract:typecheck": "tsc --noEmit --strict --skipLibCheck --resolveJsonModule --esModuleInterop --moduleResolution bundler --module esnext --target es2022 packages/api-client/src/index.ts"
  },
  "resolutions": {
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.10.1",
    "zod": "4.3.6"
  }
}
