{
  "name": "active-next",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "legal:sync": "python3 scripts/sync-legal.py",
    "legal:check": "python3 scripts/test_sync_legal.py && python3 scripts/sync-legal.py --check",
    "start": "NODE_ENV=development expo start --max-workers 2",
    "start:clear": "expo start --clear --max-workers 2",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --no-dev --port 8080",
    "test": "jest --watchAll",
    "test:once": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "test:sync": "jest tests/sync --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "prettier --write . && echo 'Code formatted successfully!'"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
