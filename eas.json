{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview-dev": {
      "developmentClient": true,
      "credentialsSource": "local",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-internal": {
      "distribution": "internal",
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "cli": {
    "appVersionSource": "remote"
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
