{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview-dev": {
      "developmentClient": true,
      "credentialsSource": "local",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview-dev"
    },
    "preview-internal": {
      "distribution": "internal",
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview-internal"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "cli": {
    "appVersionSource": "remote"
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      }
    }
  }
}
